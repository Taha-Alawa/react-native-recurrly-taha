rules_version = '2';

// Deploy with:  firebase deploy --only firestore:rules
//
// `request.auth.uid` is the Firebase Auth uid — Firebase owns sign-in, so these
// rules work as soon as they are deployed.
//
// Deny-by-default. Do NOT relax to `if true` to "get it working": the Firebase
// web config ships inside the app bundle, so an open rule means anyone who
// extracts it can read and write every user's data.

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // users/{userId} — holds the balance field.
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // users/{userId}/subscriptions/{subscriptionId}
      match /subscriptions/{subscriptionId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Anything not matched above is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
